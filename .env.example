# Pro Monetization / Midtrans
# Supabase service role key - server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=
# Midtrans server key for server-side API calls
MIDTRANS_SERVER_KEY=
# Midtrans client key for Snap.js — MUST have NEXT_PUBLIC_ prefix so it's accessible in client components
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Midtrans webhook secret for HMAC signature verification
MIDTRANS_WEBHOOK_SECRET=
# Full URL of the app e.g. https://planyourtrail.run
NEXT_PUBLIC_APP_URL=
