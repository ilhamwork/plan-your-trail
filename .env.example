NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (used for /invoice Server Actions & Basic Auth)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INVOICE_ADMIN_USER=admin
INVOICE_ADMIN_PASSWORD=change-this-strong-password

# Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgres://postgres:password@localhost:5432/planyourtrail_test

# Better Auth
BETTER_AUTH_SECRET=your-32-character-secret-key-for-development
BETTER_AUTH_URL=http://localhost:3000

# Resend (Optional in development - logs to console if omitted)
# RESEND_API_KEY=re_...
# EMAIL_FROM=PlanYourTrail <noreply@planyourtrail.run>

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
