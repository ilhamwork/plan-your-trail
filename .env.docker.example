# Environment configuration for Docker Compose & VPS deployment (SumoPod)
# ======================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=planyourtrail_dev

# Web Runtime & Secrets
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database URL used inside Docker Network (service name is 'db')
DATABASE_URL=postgres://postgres:password@db:5432/planyourtrail_dev

# Better Auth Configuration
BETTER_AUTH_SECRET=simulasi_vps_secret_32_characters_panjang_sekali_123456
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Security Secret (Bearer token)
CRON_SECRET=test_cron_secret_lokal_12345

# MinIO / S3 Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_NAME=planyourtrail
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Admin Basic Auth
INVOICE_ADMIN_USER=admin
INVOICE_ADMIN_PASSWORD=admin

# Optional: Resend Email & Google OAuth
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@planyourtrail.run
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
